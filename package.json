{
  "name": "quente-frio-desenho",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/browser/game.mjs",
    "test:frontend": "node --experimental-strip-types tests/frontend/round-updates.test.mjs && node --experimental-strip-types tests/frontend/saved-participants.test.mjs",
    "test:e2e:competition": "node tests/browser/competition.mjs",
    "test:mysql:concurrency": "php tests/integration/mysql-concurrency.php"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "laravel-echo": "2.6.1",
    "pusher-js": "^8.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "4.3.3",
    "laravel-vite-plugin": "1.0.6",
    "typescript": "5.9.3",
    "vite": "5.4.11",
    "concurrently": "^9.0.1",
    "playwright": "1.64.1"
  }
}
